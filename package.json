{
  "name": "gsdiagram",
  "displayName": "GSDiagram",
  "description": "Free diagrams of a project's processes, kept as files in the project and checked against its list of processes.",
  "version": "0.1.0",
  "publisher": "gsdiagram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carltham/GSDiagram.git"
  },
  "homepage": "https://github.com/carltham/GSDiagram#readme",
  "bugs": "https://github.com/carltham/GSDiagram/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gsdiagram.editor",
        "displayName": "GSDiagram",
        "selector": [
          {
            "filenamePattern": "*.diagram.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gsdiagram",
          "title": "GSDiagram",
          "icon": "dist/sidebar.svg"
        }
      ]
    },
    "views": {
      "gsdiagram": [
        {
          "id": "gsdiagram.diagrams",
          "name": "Diagrams"
        },
        {
          "id": "gsdiagram.architecture",
          "name": "Architecture"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gsdiagram.diagrams",
        "contents": "No diagrams in this project yet.\n[Generate diagrams](command:gsdiagram.generate)\nGenerate draws the diagrams that the architecture files in dev/architecture describe: the context, the components, each flow, and the diagrams drawn in them.\n[Set processes file](command:gsdiagram.setProcessesFile)\n[Choose data folder](command:gsdiagram.chooseFolder)\nOr write a diagram by hand: a *.diagram.json file in the data folder, .gsdiagram unless chosen. [Open the README](command:gsdiagram.openReadme) to see how."
      },
      {
        "view": "gsdiagram.architecture",
        "contents": "The architecture files in dev/architecture describe nothing yet. Describe the components in a table with Component and Uses columns, and the flows as numbered steps in a file about flows; GSDiagram reads them as a model, checks it, and draws it.\n[Open the README](command:gsdiagram.openReadme)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gsdiagram.generate",
          "when": "view == gsdiagram.diagrams",
          "group": "navigation@1"
        },
        {
          "command": "gsdiagram.update",
          "when": "view == gsdiagram.diagrams",
          "group": "navigation@2"
        },
        {
          "command": "gsdiagram.check",
          "when": "view == gsdiagram.diagrams",
          "group": "navigation@3"
        },
        {
          "command": "gsdiagram.analyse",
          "when": "view == gsdiagram.architecture",
          "group": "navigation@1"
        },
        {
          "command": "gsdiagram.check",
          "when": "view == gsdiagram.architecture",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "gsdiagram.check",
        "title": "Check",
        "category": "GSDiagram",
        "icon": "$(check-all)"
      },
      {
        "command": "gsdiagram.acceptChanges",
        "title": "Accept process changes",
        "category": "GSDiagram"
      },
      {
        "command": "gsdiagram.analyse",
        "title": "Analyse architecture",
        "category": "GSDiagram",
        "icon": "$(search)"
      },
      {
        "command": "gsdiagram.generate",
        "title": "Generate diagrams",
        "category": "GSDiagram",
        "icon": "$(add)"
      },
      {
        "command": "gsdiagram.update",
        "title": "Update diagrams",
        "category": "GSDiagram",
        "icon": "$(refresh)"
      },
      {
        "command": "gsdiagram.renderPng",
        "title": "Render PNG",
        "category": "GSDiagram"
      },
      {
        "command": "gsdiagram.chooseFolder",
        "title": "Choose data folder",
        "category": "GSDiagram"
      },
      {
        "command": "gsdiagram.setProcessesFile",
        "title": "Set processes file",
        "category": "GSDiagram"
      },
      {
        "command": "gsdiagram.openReadme",
        "title": "Open the README",
        "category": "GSDiagram"
      }
    ],
    "configuration": {
      "title": "GSDiagram",
      "properties": {
        "gsdiagram.folder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The data folder, relative to the project. Empty means .gsdiagram. A folder outside the project is refused."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node esbuild.mjs && node --test \"dist/test/*.test.js\"",
    "test:vscode": "node esbuild.mjs && node dist/test/vscode/run.js",
    "test:ui": "node esbuild.mjs && npm --prefix dev/testing/playwright test --",
    "check": "node dist/cli.js check",
    "render": "node dist/cli.js render",
    "accept": "node dist/cli.js accept",
    "analyse": "node dist/cli.js analyse",
    "generate": "node dist/cli.js generate",
    "update": "node dist/cli.js update",
    "vscode:prepublish": "node esbuild.mjs",
    "package": "vsce package",
    "release": "npm test && npm run test:vscode && npm run test:ui && npm run package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "elkjs": "^0.10.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.8.2",
    "playwright-core": "^1.50.0",
    "typescript": "^5.7.0"
  }
}
